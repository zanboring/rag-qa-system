# 复制为 .env 后按需修改：cp .env.example .env
# .env 已被 .gitignore / .dockerignore 排除，不会提交进仓库、也不会打进镜像。

# ---------- 后端选择 ----------
# 三个后端互相独立，可任意组合。默认组合是零依赖的：无 GPU / 无网络 / 无 Key 也能跑。
EMBEDDING_BACKEND=hash          # hash（零依赖）| bge（本地）| ollama（本地）| zhipu（云端）
VECTOR_BACKEND=memory           # memory（内存，重启丢）| chroma（需 pip install chromadb）
LLM_BACKEND=mock                # mock（假模型，仅验证链路）| ollama（本地）
                                # | deepseek（云端）| glm4（云端）

# ---------- 切片参数 ----------
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ---------- 向量库持久化 ----------
# 仅在 VECTOR_BACKEND=chroma 时生效。留空表示纯内存模式，进程退出数据即丢失。
CHROMA_PATH=/data/chroma

# ---------- DeepSeek（LLM_BACKEND=deepseek 时必填）----------
# 注意：DeepSeek 只提供对话接口，**没有 embedding 接口**，
# 因此不能用它替代 EMBEDDING_BACKEND，只能用于「生成」与「评测裁判」。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat

# ---------- 智谱 GLM-4（LLM_BACKEND=glm4 或 EMBEDDING_BACKEND=zhipu 时必填）----------
# API Key 兼容两种变量名：ZHIPU_API_KEY（社区写法）与 ZHIPUAI_API_KEY（官方 SDK 写入）
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_EMBED_MODEL=embedding-3
ZHIPU_CHAT_MODEL=glm-4-flash

# ---------- Ollama 本地模型 ----------
# 容器内的 localhost 指向容器自身，访问宿主机模型需用 host.docker.internal
# 变量名也兼容 OLLAMA_API_BASE（Ollama 生态常用写法），可自动复用已有配置
OLLAMA_BASE_URL=http://host.docker.internal:11434

# 生成模型（LLM_BACKEND=ollama 时使用）
OLLAMA_MODEL=qwen2.5:7b

# embedding 模型（EMBEDDING_BACKEND=ollama 时使用）
# 默认 bge-m3：多语言、中文效果好。
# ⚠ 不要用 nomic-embed-text 做中文检索：实测它在中文上语义区分失效
#   （同义句相似度 0.67 反而低于无关句 0.71），英文正常、中文不可用。
#   选 embedding 模型必须用目标语言的语料验证。
OLLAMA_EMBED_MODEL=bge-m3

# ---------- 评测裁判（eval/run_eval.py 使用）----------
# 留空则按 DEEPSEEK_API_KEY → ZHIPU_API_KEY 顺序自动选择；
# 都没有时降级为规则裁判，此时忠实度 / 答案相关性显示为 n/a（不产出伪数据）。
# 也可以直接用命令行强制零成本的规则裁判：python -m eval.run_eval --judge rule
JUDGE_API_KEY=
JUDGE_BASE_URL=
JUDGE_MODEL=
JUDGE_CONCURRENCY=4
