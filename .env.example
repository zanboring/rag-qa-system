# 复制为 .env 后按需修改：cp .env.example .env
# .env 已被 .gitignore / .dockerignore 排除，不会提交进仓库、也不会打进镜像。

# ---------- 后端选择 ----------
# 三个后端互相独立，可任意组合。默认组合是零依赖的：无 GPU / 无网络 / 无 Key 也能跑。
EMBEDDING_BACKEND=hash          # hash（零依赖）| bge（本地模型）| zhipu（云端）
VECTOR_BACKEND=memory           # memory（内存，重启丢）| chroma（需 pip install chromadb）
LLM_BACKEND=mock                # mock（假模型，仅验证链路）| ollama（本地）| glm4（云端）

# ---------- 切片参数 ----------
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ---------- 向量库持久化 ----------
# 仅在 VECTOR_BACKEND=chroma 时生效。留空表示纯内存模式，进程退出数据即丢失。
CHROMA_PATH=/data/chroma

# ---------- 智谱 GLM-4（LLM_BACKEND=glm4 或 EMBEDDING_BACKEND=zhipu 时必填）----------
ZHIPU_API_KEY=
ZHIPU_EMBED_MODEL=embedding-3
ZHIPU_CHAT_MODEL=glm-4-flash

# ---------- Ollama 本地模型（LLM_BACKEND=ollama 时使用）----------
# 容器内的 localhost 指向容器自身，访问宿主机模型需用 host.docker.internal
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

# ---------- 评测裁判（eval/run_eval.py 使用）----------
# 不填则自动降级为规则裁判，此时忠实度 / 答案相关性显示为 n/a（不产出伪数据）
JUDGE_BASE_URL=https://open.bigmodel.cn/api/paas/v4
JUDGE_MODEL=glm-4-flash
JUDGE_API_KEY=
JUDGE_CONCURRENCY=4
